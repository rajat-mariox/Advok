# Base URL of the ADVOK backend API (no trailing slash).
# Copy to .env for local dev, .env.production for local production builds.
# Local dev:        http://localhost:4000/api  (port must match backend/.env PORT)
# Vercel backend:   https://advok-mu.vercel.app/api
# EC2 (direct):     http://<EC2_PUBLIC_IP>:4000/api
# EC2 (via nginx):  https://api.yourdomain.com/api
# NOTE: on Vercel, set VITE_API_BASE in the project's Environment Variables
# (env files are gitignored) and redeploy — Vite bakes it in at build time.
VITE_API_BASE=http://localhost:4000/api
